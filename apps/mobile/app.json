{
  "expo": {
    "name": "MLAMH",
    "slug": "mlamh",
    "scheme": "mlamh",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/app-icon.png",
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MLAMH to access your photos so you can build your talent portfolio.",
          "cameraPermission": "Allow MLAMH to use your camera for talent portfolio photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D4A017",
          "defaultChannel": "mlamh-updates",
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "net.mlamh.app",
      "buildNumber": "1",
      "associatedDomains": ["applinks:mlamh.net", "applinks:www.mlamh.net"]
    },
    "android": {
      "package": "net.mlamh.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#000000"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "mlamh.net" },
            { "scheme": "https", "host": "www.mlamh.net" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
