{
  "expo": {
    "name": "MLAMH",
    "slug": "mlamh",
    "scheme": "mlamh",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/app-icon.png",
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/app-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#050505",
          "dark": {
            "image": "./assets/app-icon.png",
            "backgroundColor": "#050505"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MLAMH to access your photos so you can build your talent portfolio.",
          "cameraPermission": "Allow MLAMH to use your camera for talent portfolio photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C9A962",
          "defaultChannel": "mlamh-updates",
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "net.mlamh.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:mlamh.net",
        "applinks:www.mlamh.net"
      ]
    },
    "android": {
      "package": "net.mlamh.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#050505"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "mlamh.net"
            },
            {
              "scheme": "https",
              "host": "www.mlamh.net"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "ca757cb1-e91c-4e8c-a3a9-6cee885e483a"
      }
    }
  }
}
